# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=incubrix-development-secret-key-32chars-min

# Stock & Video Provider Credentials (Optional: mock adapter active if empty)
PEXELS_API_KEY=
PIXABAY_API_KEY=         # Get free API key at https://pixabay.com/api/docs/

# Background Image APIs (High-definition photographic backgrounds for any context)
UNSPLASH_ACCESS_KEY=  # https://unsplash.com/developers

# Talking Avatar / Character Animation APIs (Photorealistic talking human video)
DID_API_KEY=          # https://www.d-id.com
HEYGEN_API_KEY=       # https://www.heygen.com
SIMLI_API_KEY=        # https://www.simli.com

# LLM & Vision Service Configuration
LLM_PROVIDER=rule_based  # options: rule_based, openai, gemini, mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Speech Engine Configuration
TTS_DEFAULT_VOICE_EN=en-US-AriaNeural
TTS_DEFAULT_VOICE_HI=hi-IN-SwaraNeural
TTS_DEFAULT_VOICE_TA=ta-IN-PallaviNeural
WHISPER_MODEL_SIZE=base  # tiny, base, small

# Storage Configuration (Local directory or S3/MinIO)
STORAGE_MODE=local       # 'local' or 's3'
LOCAL_STORAGE_DIR=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=incubrix-broll

# Job & Execution Settings
MAX_JOB_CONCURRENCY=4
MAX_AUDIO_DURATION_SECONDS=600
MIN_SCENE_DURATION_SECONDS=1.8
MAX_SCENE_DURATION_SECONDS=7.0
VLM_EVALUATION_ENABLED=true
